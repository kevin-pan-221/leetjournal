{
  "name": "leetjournal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "setup": "bash setup.sh",
    "doctor": "bash setup.sh --check",
    "dev": "vite",
    "predev": "node scripts/prepare-python.mjs",
    "prebuild": "node scripts/prepare-python.mjs",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "check": "tsc -b",
    "check:all": "npm run check && npm run test:unit && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && npm test",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "judge:build": "python3 scripts/judge/build.py",
    "judge:check": "python3 scripts/judge/selfcheck.py",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@tauri-apps/api": "^2.8.0",
    "@vitejs/plugin-react": "latest",
    "codemirror": "6.0.2",
    "lucide-react": "latest",
    "pyodide": "314.0.7",
    "react": "latest",
    "react-dom": "latest",
    "three": "^0.186.1",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "^0.186.0"
  }
}
