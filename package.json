{
  "name": "leetjournal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "setup": "bash setup.sh",
    "doctor": "bash setup.sh --check",
    "dev": "vite",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "check": "tsc -b",
    "check:all": "npm run check && npm run test:unit && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && npm test",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "pixi.js": "^8.20.1",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
